{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo 'skipping root install'",
  "buildCommand": "cd selly-app && npm install --legacy-peer-deps && npx expo export --platform web",
  "outputDirectory": "selly-app/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/|_expo|assets|favicon|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/_expo/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
